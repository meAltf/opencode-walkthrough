{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "edit": "allow",
    "bash": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "question": "allow"
  },

  "mcp": {
    "servers": {
      "weather": {
        "type": "local",
        "command": ["npx", "-y", "open-meteo-mcp-server"]
      },
      "docs": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },

  "agent": {
    "plan": {
      "model": "opencode/gpt-5.1-codex"
    }
  }
}
